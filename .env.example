# Server Port Configuration
PORT=3001

# Authentication Credentials (Mandatory: Server requires ADMIN_PASSWORD and STAFF_PASSWORD to start)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password
STAFF_USERNAME=operator
STAFF_PASSWORD=your_secure_staff_password

# Optional: Path to custom Google Chrome executable for Puppeteer / WhatsApp Web Client
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# ── Sensitive Provider Credentials (Loaded into environment via dotenv) ──────
# These keys are stored exclusively in .env and are NOT saved in leads.db.

# Google Places / Maps API Key (used for lead scraping and Google Maps Places lookup)
PLACES_API_KEY=

# OpenAI API Key (used for AI Copilot reply generation, intent classification, and pitch drafts)
OPENAI_API_KEY=

# Google OAuth2 Client Secret (used for Gmail outreach and Google Sheets sync)
GOOGLE_CLIENT_SECRET=

# Google OAuth2 Tokens (JSON serialized credentials containing access & refresh tokens)
GOOGLE_TOKENS=

# Telegram Bot Token (used for admin notification broadcasts & reply alerts via @BotFather)
TELEGRAM_BOT_TOKEN=

# Telegram API Hash (used for GramJS user client outreach via my.telegram.org)
TELEGRAM_API_HASH=

# Telegram GramJS User Session string (persisted permanently upon successful user login)
TELEGRAM_USER_SESSION=
